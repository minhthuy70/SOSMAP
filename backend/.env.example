# SOSMAP Environment Configuration Example
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sosmap
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
STRICT_RATE_LIMIT_MAX=10
STRICT_RATE_LIMIT_WINDOW=60000
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW=3600000
USER_RATE_LIMIT_MAX=200
USER_RATE_LIMIT_WINDOW=900000

# Logging
LOG_LEVEL=info

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@sosmap.vn

# Geocoding Configuration (Optional)
GEOCODING_PROVIDER=openstreetmap
# For Google Maps, add:
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# File Upload Configuration
MAX_FILE_SIZE=10485760

# WebSocket Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
